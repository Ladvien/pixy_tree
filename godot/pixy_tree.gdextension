[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
macos.debug.arm64 = "res://../rust/target/debug/libpixy_tree.dylib"
macos.release.arm64 = "res://../rust/target/release/libpixy_tree.dylib"
linux.debug.x86_64 = "res://../rust/target/debug/libpixy_tree.so"
linux.release.x86_64 = "res://../rust/target/release/libpixy_tree.so"
windows.debug.x86_64 = "res://../rust/target/debug/pixy_tree.dll"
windows.release.x86_64 = "res://../rust/target/release/pixy_tree.dll"
